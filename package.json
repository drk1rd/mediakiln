{
  "name": "mediakiln",
  "version": "0.1.0",
  "description": "Bake the media in a static site so it's ready to stream: faststart MP4, HLS, posters, AVIF/WebP, srcset.",
  "license": "MIT",
  "author": "Suryansh Prajapati",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drk1rd/mediakiln.git"
  },
  "type": "module",
  "bin": {
    "mediakiln": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/plugins/vite.d.ts",
      "default": "./dist/plugins/vite.js"
    },
    "./astro": {
      "types": "./dist/plugins/astro.d.ts",
      "default": "./dist/plugins/astro.js"
    },
    "./eleventy": {
      "types": "./dist/plugins/eleventy.d.ts",
      "default": "./dist/plugins/eleventy.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "video",
    "hls",
    "ffmpeg",
    "images",
    "avif",
    "webp",
    "static-site",
    "optimization",
    "faststart"
  ],
  "dependencies": {
    "cac": "^7.1.0",
    "hls.js": "^1.7.3",
    "p-limit": "^7.3.3",
    "parse5": "^8.0.1",
    "picomatch": "^4.0.7",
    "sharp": "^0.35.5",
    "tinyglobby": "^0.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
